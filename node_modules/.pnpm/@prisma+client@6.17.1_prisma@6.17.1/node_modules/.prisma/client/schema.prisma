// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output = "./prisma/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                 @id @default(autoincrement())
  name              String
  email             String              @unique
  password          String
  role              String              @default("teacher") // 'teacher', 'admin', or 'student'
  createdAt         DateTime            @default(now())
  classes           Class[]             @relation("TeacherClasses")
  attendance        Attendance[]        @relation("MarkedBy")
  student           Student?            @relation("UserStudent")
  respondedRequests AttendanceRequest[] @relation("RequestResponder")
}

model Class {
  id                 Int                 @id @default(autoincrement())
  name               String
  section            String?
  subject            String?
  description        String?
  schedule           String?
  room               String?
  teacher            User?               @relation("TeacherClasses", fields: [teacherId], references: [id])
  teacherId          Int?
  createdAt          DateTime            @default(now())
  classStudents      ClassStudent[]
  attendance         Attendance[]
  attendanceRequests AttendanceRequest[]
}

model Student {
  id                 Int                 @id @default(autoincrement())
  name               String
  email              String?             @unique
  registrationNumber String?             @unique
  password           String? // Store the generated password for admin reference
  faceEncoding       String?             @db.Text // Store serialized face descriptor
  faceEnrolled       Boolean             @default(false)
  user               User?               @relation("UserStudent", fields: [userId], references: [id])
  userId             Int?                @unique
  createdAt          DateTime            @default(now())
  classStudents      ClassStudent[]
  attendance         Attendance[]
  attendanceRequests AttendanceRequest[]
}

model ClassStudent {
  id         Int      @id @default(autoincrement())
  class      Class    @relation(fields: [classId], references: [id])
  classId    Int
  student    Student  @relation(fields: [studentId], references: [id])
  studentId  Int
  enrolledAt DateTime @default(now())

  @@unique([classId, studentId])
}

model Attendance {
  id         Int      @id @default(autoincrement())
  class      Class    @relation(fields: [classId], references: [id])
  classId    Int
  student    Student  @relation(fields: [studentId], references: [id])
  studentId  Int
  date       DateTime
  status     String // 'present', 'absent', 'late', etc.
  method     String   @default("manual") // 'manual', 'face_recognition'
  markedBy   User?    @relation("MarkedBy", fields: [markedById], references: [id])
  markedById Int?
  markedAt   DateTime @default(now())

  @@unique([classId, studentId, date])
}

model AttendanceRequest {
  id            Int       @id @default(autoincrement())
  student       Student   @relation(fields: [studentId], references: [id])
  studentId     Int
  class         Class     @relation(fields: [classId], references: [id])
  classId       Int
  status        String    @default("pending") // 'pending', 'approved', 'rejected', 'expired'
  requestedAt   DateTime  @default(now())
  respondedAt   DateTime?
  respondedBy   User?     @relation("RequestResponder", fields: [respondedById], references: [id])
  respondedById Int?
  expiresAt     DateTime? // Optional expiration timestamp
  reason        String? // Optional reason for request

  @@index([studentId, classId, status])
  @@index([classId, status])
}
